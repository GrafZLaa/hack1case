OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_MODEL_CANDIDATES=llama3.2-vision,moondream,llama3.2
ENABLE_LLM=1
LLM_REQUEST_TIMEOUT=55
LLM_CONNECT_TIMEOUT=5
LLM_MAX_TOTAL_SEC=90
LLM_MODEL_FAILOVER_TRIES=1
LLM_PRIMARY_MAX_IMAGES=1
LLM_TEXT_LIMIT=12000
LLM_RETRY_TEXT_LIMIT=5000
LLM_FALLBACK_TEXT_LIMIT=2800

MAX_LLM_IMAGES=2
OCR_WORKERS=4
OCR_IF_EMBEDDED_CHARS=120
OCR_LANG=rus+eng
OCR_PSMS=3,6,11
PDF_RENDER_SCALE=2.0
OCR_MAX_VARIANTS=2
OCR_QUALITY_SHORTCIRCUIT=320
OCR_DATE_TESSERACT_TIMEOUT_SEC=3
OCR_RELEASE_SCAN_BUDGET_SEC=5
FLASK_DEBUG=1

REGISTRY_STATE_FILE=data/registry_state.json
FEEDBACK_FILE=data/feedback_log.jsonl
CONTROL_SAMPLES_FILE=samples/control_samples.json
MAX_REGISTRY_RECORDS=2000
REGISTRY_B64_MAX=12000000
REGISTRY_MAX_IMAGES=1000
